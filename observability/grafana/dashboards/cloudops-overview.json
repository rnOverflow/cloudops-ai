{
 "uid": "cloudops-overview",
 "title": "CloudOps AI \u2014 Service Overview",
 "schemaVersion": 39,
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "refresh": "10s",
 "tags": [
  "cloudops"
 ],
 "panels": [
  {
   "type": "stat",
   "title": "Active incidents",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "cloudops_active_incidents",
     "refId": "A"
    }
   ]
  },
  {
   "type": "stat",
   "title": "Incidents opened (24h)",
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sum(increase(cloudops_incidents_opened_total[24h]))",
     "refId": "A"
    }
   ]
  },
  {
   "type": "stat",
   "title": "Remediations succeeded (24h)",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sum(increase(cloudops_remediations_total{result=\"succeeded\"}[24h]))",
     "refId": "A"
    }
   ]
  },
  {
   "type": "stat",
   "title": "Control loop p95 (s)",
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, rate(cloudops_control_loop_seconds_bucket[5m]))",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "CPU %",
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "cloudops_service_cpu_percent",
     "legendFormat": "{{service}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "thresholdsStyle": {
       "mode": "line+area"
      }
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 85
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "type": "timeseries",
   "title": "Memory (max pod) %",
   "gridPos": {
    "x": 8,
    "y": 4,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "cloudops_service_memory_max_pod_percent",
     "legendFormat": "{{service}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "thresholdsStyle": {
       "mode": "line+area"
      }
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 85
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "type": "timeseries",
   "title": "p95 latency",
   "gridPos": {
    "x": 16,
    "y": 4,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "cloudops_service_latency_p95_ms",
     "legendFormat": "{{service}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ms",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "thresholdsStyle": {
       "mode": "line+area"
      }
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 500
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "type": "timeseries",
   "title": "Throughput",
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "cloudops_service_rps",
     "legendFormat": "{{service}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10
     }
    },
    "overrides": []
   }
  },
  {
   "type": "timeseries",
   "title": "Error rate",
   "gridPos": {
    "x": 8,
    "y": 12,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "cloudops_service_error_rate",
     "legendFormat": "{{service}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "thresholdsStyle": {
       "mode": "line+area"
      }
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 0.05
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "type": "timeseries",
   "title": "HTTP 5xx / s",
   "gridPos": {
    "x": 16,
    "y": 12,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "cloudops_service_http_5xx_rps",
     "legendFormat": "{{service}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10
     }
    },
    "overrides": []
   }
  },
  {
   "type": "timeseries",
   "title": "Ready pods",
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "cloudops_service_healthy_pods",
     "legendFormat": "{{service}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10
     }
    },
    "overrides": []
   }
  },
  {
   "type": "timeseries",
   "title": "Restarts",
   "gridPos": {
    "x": 8,
    "y": 20,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "cloudops_service_restarts",
     "legendFormat": "{{service}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10
     }
    },
    "overrides": []
   }
  },
  {
   "type": "timeseries",
   "title": "DB connections",
   "gridPos": {
    "x": 16,
    "y": 20,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "cloudops_service_db_connections",
     "legendFormat": "{{service}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10
     }
    },
    "overrides": []
   }
  },
  {
   "type": "timeseries",
   "title": "Network RX",
   "gridPos": {
    "x": 0,
    "y": 28,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "cloudops_service_network_rx_kbps",
     "legendFormat": "{{service}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "KBs",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10
     }
    },
    "overrides": []
   }
  },
  {
   "type": "timeseries",
   "title": "Availability",
   "gridPos": {
    "x": 8,
    "y": 28,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "cloudops_service_availability",
     "legendFormat": "{{service}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10
     }
    },
    "overrides": []
   }
  },
  {
   "type": "timeseries",
   "title": "Demo services: request rate by status",
   "gridPos": {
    "x": 16,
    "y": 28,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sum by (service, status) (rate(http_requests_total[1m]))",
     "legendFormat": "{{service}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10
     }
    },
    "overrides": []
   }
  },
  {
   "type": "logs",
   "title": "Logs (Loki)",
   "gridPos": {
    "x": 0,
    "y": 36,
    "w": 24,
    "h": 10
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "expr": "{logging=\"promtail\"} |= \"\"",
     "refId": "A"
    }
   ]
  }
 ]
}