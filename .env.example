# Copy to .env (or run scripts/bootstrap_env.sh, which generates strong random values).
# Never commit .env. Never put real secrets in this file.

ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://cloudops:CHANGE_ME@localhost:5432/cloudops_ai
POSTGRES_PASSWORD=CHANGE_ME

# >= 32 random characters. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_TTL_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Local demo accounts are only created when SEED_DEMO_USERS=true and a password is set.
SEED_DEMO_USERS=true
SEED_ADMIN_PASSWORD=
SEED_SRE_PASSWORD=
SEED_DEVELOPER_PASSWORD=
SEED_VIEWER_PASSWORD=

# Cloud provider: local | aws
CLOUD_PROVIDER=local
TICK_SECONDS=2
VERIFY_AFTER_TICKS=5

# AWS (only when CLOUD_PROVIDER=aws). Credentials come from the standard AWS chain, not this file.
AWS_REGION=us-east-1
AWS_ECS_CLUSTER=
AWS_SERVICE_MAP=api-gateway=cloudops-api-gateway,user-service=cloudops-user-service,payment-service=cloudops-payment-service,notification-service=cloudops-notification-service
AWS_RDS_INSTANCE_ID=

# AI: none | openai  (OpenAI-compatible: OpenAI, Azure OpenAI, Ollama, vLLM)
LLM_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=INFO
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
# Enables /chaos/* endpoints on the real demo microservices (compose profile `services`). Empty = disabled.
CHAOS_TOKEN=
